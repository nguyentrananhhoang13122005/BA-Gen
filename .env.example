# Cấu hình Cổng LLM mặc định: groq | openrouter | gemini | offline
DEFAULT_PROVIDER=groq

# Khóa API các nhà cung cấp (điền ít nhất 1 khóa bạn có)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình tương ứng từng nhà cung cấp
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_MODEL=gemini-1.5-flash

# Ngưỡng tin cậy để định tuyến sang LLM (mặc định 0.75)
CONFIDENCE_THRESHOLD=0.75

# Đường dẫn tệp SQLite cục bộ
DATABASE_PATH=reqassist.db
